{
  "name": "vibe-focus",
  "productName": "Vibe Focus",
  "version": "1.0.0",
  "description": "Vibe Focus · 桌宠番茄钟 + 情绪打卡（Electron 桌面版）",
  "main": "main.js",
  "author": "Vibe Focus",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.vibefocus.desktop",
    "productName": "Vibe Focus",
    "copyright": "Copyright © 2026 Vibe Focus",
    "files": [
      "index.html",
      "main.js"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "VibeFocus-${version}-Setup-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vibe Focus"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "VibeFocus-${version}-${arch}.${ext}",
      "extendInfo": {
        "LSUIElement": 1
      }
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "build/icon.png",
      "category": "Utility",
      "artifactName": "VibeFocus-${version}-${arch}.${ext}"
    }
  }
}
